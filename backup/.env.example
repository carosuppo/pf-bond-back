AWS_ENDPOINT=https://BACKUP_PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_REGION=BACKUP_PROJECT_REGION
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=BACKUP_PROJECT_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=BACKUP_PROJECT_S3_SECRET_KEY
WALG_S3_PREFIX=s3://bond-backups/bond/postgres
WALG_COMPRESSION_METHOD=zstd
WALG_DELTA_MAX_STEPS=7
WALG_DELTA_ORIGIN=LATEST
WALG_LIBSODIUM_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32
WALG_LIBSODIUM_KEY_TRANSFORM=base64
RESTIC_REPOSITORY=rclone:supabase:bond-backups/bond/media
RESTIC_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
RESTIC_CACHE_DIR=/tmp/restic-cache
BACKUP_DB_HEARTBEAT_URL=
BACKUP_MEDIA_HEARTBEAT_URL=
BACKUP_WAL_HEARTBEAT_URL=
