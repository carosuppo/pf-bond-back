datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleEnum {
  ADMIN
  MEMBER
}

// Models
model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  currentLocation  Location?  @relation(fields: [locationId], references: [id])
  locationId       Int?       @unique

  sessions UserSession[]
  members          Member[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id                               Int            @id @default(autoincrement())
  name                             String
  shareLocationMandatorily         Boolean        @default(false)
  
  members                          Member[]
  events                           Event[]
  pointsOfInterest                 PointOfInterest[]
  reminders                        Reminder[]

  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt
  deletedAt                        DateTime?
}

model Member {
  id        Int    @id @default(autoincrement())
  userId    Int
  groupId   Int
  role      RoleEnum
  // roleId    Int

  // role      Role   @relation(fields: [roleId], references: [id])
  group     Group  @relation(fields: [groupId], references: [id])
  user      User   @relation(fields: [userId], references: [id])

  @@unique([userId, groupId])
}

model Event {
  id              Int       @id @default(autoincrement())
  date            DateTime
  name            String
  budget          Int
  accumulatedCash Int       @default(0)
  groupId         Int

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  
  group           Group     @relation(fields: [groupId], references: [id])
}

model Reminder {
  id          Int       @id @default(autoincrement())
  description String
  dueDate     DateTime
  groupId     Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  group       Group     @relation(fields: [groupId], references: [id])
}

model PointOfInterest {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  radius          Float
  isTemporary     Boolean   @default(false)
  endTime         DateTime?
  locationId      Int       @unique
  groupId         Int
  createdByUserId Int

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  group           Group     @relation(fields: [groupId], references: [id])
  location        Location  @relation(fields: [locationId], references: [id])
  // createdBy       User      @relation(fields: [createdByUserId], references: [id])
}

model Location {
  id              Int              @id @default(autoincrement())
  coordinates     String
  user            User?
  pointOfInterest PointOfInterest?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}