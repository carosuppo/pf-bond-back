datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleEnum {
  ADMIN
  MEMBER
}

enum ExpenseSplitType {
  EQUAL
  CUSTOM
}

// Models
enum NotificationType {
  POINT_OF_INTEREST_CREATED
  POINT_OF_INTEREST_UPDATED
  POINT_OF_INTEREST_ENTERED
  POINT_OF_INTEREST_EXITED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_CANCELLED
}

enum SecurityEventType {
  AUTH_LOGIN_FAILED
  LOCATION_UNAUTHORIZED
  LOCATION_FORBIDDEN
}

enum SecurityAlertType {
  AUTH_LOGIN_FAILED
  LOCATION_ACCESS_DENIED
}

enum SecurityAlertStatus {
  PENDING
  SENT
  FAILED
}

model User {
  notificationsEnabled Boolean @default(true)
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  passwordHash    String
  profilePhoto    String?   @db.Text
  profilePhotoPath String?
  currentLocation Location? @relation(fields: [locationId], references: [id])
  locationId      Int?      @unique

  members  Member[]
  sessions UserSession[]
  devicePushTokens DevicePushToken[]

  emailVerifiedAt         DateTime?
  emailVerificationTokens EmailVerificationToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DevicePushToken {
  id       Int    @id @default(autoincrement())
  userId   Int
  token    String @unique
  platform String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id                       Int     @id @default(autoincrement())
  name                     String
  image                    String
  description              String?
  shareLocationMandatorily Boolean @default(false)
  invitationCode           String  @unique

  members          Member[]
  events           Event[]
  pointsOfInterest PointOfInterest[]
  reminders        Reminder[]
  expenseAccounts  ExpenseAccount[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Member {
  notificationsEnabled Boolean @default(true)
  notificationPreferences MemberNotificationPreference[]
  pointOfInterestPresences PointOfInterestPresence[]
  id                     Int      @id @default(autoincrement())
  userId                 Int
  groupId                Int
  role                   RoleEnum
  locationSharingEnabled Boolean  @default(false)

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  eventMembers EventMember[]
  eventReminders EventReminder[]
  expenseAccountMembers ExpenseAccountMember[]
  paidExpenses Expense[] @relation("ExpensePayer")
  expenseShares ExpenseShare[] @relation("ExpenseShareMember")
  sentExpensePayments ExpensePayment[] @relation("ExpensePaymentSender")
  receivedExpensePayments ExpensePayment[] @relation("ExpensePaymentRecipient")

  @@unique([userId, groupId])
}

model Event {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  startAt         DateTime
  endAt           DateTime?
  groupId         Int
  locationId      Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group Group @relation(fields: [groupId], references: [id])
  members EventMember[]
  location Location? @relation(fields: [locationId], references: [id])
  reminders EventReminder[]
  expenseAccounts ExpenseAccount[]
}

model EventMember {
  id        Int @id @default(autoincrement())
  eventId   Int
  memberId  Int

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([memberId])
}

model EventReminder {
  id          Int       @id @default(autoincrement())
  eventId     Int
  memberId    Int
  leadMinutes Int
  remindAt    DateTime
  sentAt      DateTime?
  utcOffsetMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId, leadMinutes])
  @@index([eventId])
  @@index([remindAt])
}

model ExpenseAccount {
  id        Int      @id @default(autoincrement())
  name      String
  groupId   Int
  eventId   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group  @relation(fields: [groupId], references: [id])
  event   Event? @relation(fields: [eventId], references: [id])
  members ExpenseAccountMember[]
  expenses Expense[]

  @@index([groupId])
  @@index([eventId])
}

model ExpenseAccountMember {
  id               Int @id @default(autoincrement())
  expenseAccountId Int
  memberId         Int

  expenseAccount ExpenseAccount @relation(fields: [expenseAccountId], references: [id], onDelete: Cascade)
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseAccountId, memberId])
  @@index([memberId])
}

model Expense {
  id               Int              @id @default(autoincrement())
  expenseAccountId Int
  payerMemberId    Int
  title            String?
  amountCents      Int
  splitType        ExpenseSplitType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account ExpenseAccount @relation(fields: [expenseAccountId], references: [id], onDelete: Cascade)
  payer   Member         @relation("ExpensePayer", fields: [payerMemberId], references: [id], onDelete: Cascade)
  shares  ExpenseShare[]
  payments ExpensePayment[]

  @@index([expenseAccountId])
  @@index([payerMemberId])
}

model ExpenseShare {
  id          Int @id @default(autoincrement())
  expenseId   Int
  memberId    Int
  amountCents Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  Member  @relation("ExpenseShareMember", fields: [memberId], references: [id], onDelete: Cascade)
  payment ExpensePayment?

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model ExpensePayment {
  id              Int      @id @default(autoincrement())
  expenseId       Int
  expenseShareId  Int      @unique
  fromMemberId    Int
  toMemberId      Int
  amountCents     Int
  createdAt       DateTime @default(now())
  confirmedAt     DateTime @default(now())

  expense      Expense      @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  expenseShare ExpenseShare @relation(fields: [expenseShareId], references: [id], onDelete: Restrict)
  fromMember   Member       @relation("ExpensePaymentSender", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember     Member       @relation("ExpensePaymentRecipient", fields: [toMemberId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  description String
  dueDate     DateTime
  groupId     Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group Group @relation(fields: [groupId], references: [id])
}

enum PointOfInterestColor {
  RED
  GREEN
  ORANGE
  BLUE
  PURPLE
  GREY
  BLACK
}

enum PointOfInterestValidity {
  PERMANENT
  TWELVE_HOURS
  ONE_DAY
  THREE_DAYS
}

model PointOfInterest {
  color PointOfInterestColor @default(BLUE)
  presences PointOfInterestPresence[]
  id          Int       @id @default(autoincrement())
  name        String
  radius      Float
  validity    PointOfInterestValidity @default(PERMANENT)
  endTime     DateTime?
  locationId  Int       @unique
  groupId     Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group    Group    @relation(fields: [groupId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
}

model Location {
  id              Int              @id @default(autoincrement())
  latitude        Float
  longitude       Float
  accuracy        Float?
  capturedAt      DateTime?
  lastSeenAt      DateTime?
  user            User?
  pointOfInterest PointOfInterest?
  events           Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberNotificationPreference {
  id Int @id @default(autoincrement())
  memberId Int
  type NotificationType
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type])
}

model PointOfInterestPresence {
  id Int @id @default(autoincrement())
  memberId Int
  pointOfInterestId Int
  isInside Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pointOfInterest PointOfInterest @relation(fields: [pointOfInterestId], references: [id], onDelete: Cascade)

  @@unique([memberId, pointOfInterestId])
  @@index([pointOfInterestId])
}

model SecurityEvent {
  id             Int               @id @default(autoincrement())
  type           SecurityEventType
  ip             String?           @db.VarChar(45)
  userId         Int?
  identifierHash String?           @db.Char(64)
  method         String            @db.VarChar(10)
  path           String            @db.VarChar(500)
  statusCode     Int
  createdAt      DateTime          @default(now())

  @@index([type, createdAt])
  @@index([identifierHash, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model SecurityAlert {
  id             Int                 @id @default(autoincrement())
  type           SecurityAlertType
  correlationKey String              @db.VarChar(255)
  eventCount     Int
  windowSeconds  Int
  status         SecurityAlertStatus @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([type, correlationKey, createdAt])
}
