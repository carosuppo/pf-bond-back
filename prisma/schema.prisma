datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleEnum {
  ADMIN
  MEMBER
}

enum GroupJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Models
enum NotificationType {
  POINT_OF_INTEREST_CREATED
  POINT_OF_INTEREST_UPDATED
  POINT_OF_INTEREST_ENTERED
  POINT_OF_INTEREST_EXITED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_CANCELLED
}

enum SecurityEventType {
  AUTH_LOGIN_FAILED
  LOCATION_UNAUTHORIZED
  LOCATION_FORBIDDEN
}

enum SecurityAlertType {
  AUTH_LOGIN_FAILED
  LOCATION_ACCESS_DENIED
}

enum SecurityAlertStatus {
  PENDING
  SENT
  FAILED
}

model User {
  notificationsEnabled Boolean   @default(true)
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  passwordHash         String
  profilePhoto         String?   @db.Text
  profilePhotoPath     String?
  currentLocation      Location? @relation(fields: [locationId], references: [id])
  locationId           Int?      @unique

  members                 Member[]
  sessions                UserSession[]
  devicePushTokens        DevicePushToken[]
  groupJoinRequests       GroupJoinRequest[]
  groupInboxNotifications GroupInboxNotification[]

  emailVerifiedAt         DateTime?
  ageVerifiedAt           DateTime?
  termsAcceptedAt         DateTime?
  termsAcceptedVersion    String?
  lastActivityAt          DateTime?
  emailVerificationTokens EmailVerificationToken[]
  accountDeletionRequest  AccountDeletionRequest?
  blocksMade              UserBlock[]              @relation("UserBlocksMade")
  blocksReceived          UserBlock[]              @relation("UserBlocksReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DevicePushToken {
  id       Int    @id @default(autoincrement())
  userId   Int
  token    String @unique
  platform String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountDeletionRequest {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model UserSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBlock {
  id            Int      @id @default(autoincrement())
  blockerUserId Int
  blockedUserId Int
  createdAt     DateTime @default(now())

  blocker User @relation("UserBlocksMade", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model Group {
  documentFolders          DocumentFolder[]
  documents                FamilyDocument[]
  id                       Int              @id @default(autoincrement())
  name                     String
  image                    String
  description              String?
  shareLocationMandatorily Boolean          @default(false)
  invitationCode           String           @unique

  members            Member[]
  eventRecurrences   EventRecurrence[]
  events             Event[]
  pointsOfInterest   PointOfInterest[]
  reminders          Reminder[]
  expenseAccounts    ExpenseAccount[]
  joinRequests       GroupJoinRequest[]
  inboxNotifications GroupInboxNotification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model DocumentFolder {
  id        String           @id @default(uuid())
  groupId   Int
  name      String           @db.VarChar(200)
  parentId  String?
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId, groupId], references: [id, groupId], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents FamilyDocument[]

  @@unique([id, groupId])
  @@index([groupId, parentId])
}

model FamilyDocument {
  id         String          @id @default(uuid())
  groupId    Int
  memberId   Int?
  memberName String?
  folderId   String?
  name       String          @db.VarChar(200)
  objectPath String          @unique
  mimeType   String
  size       Int
  creatorId  Int
  version    Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  folder     DocumentFolder? @relation(fields: [folderId, groupId], references: [id, groupId], onDelete: Cascade)
  object     DocumentObject  @relation(fields: [objectPath], references: [path])

  @@index([groupId, folderId])
  @@index([groupId, memberId])
}

// Durable upload journal. Retired versions remain private for disaster recovery.
model DocumentObject {
  path      String          @id
  state     String          @default("pending")
  createdAt DateTime        @default(now())
  retiredAt DateTime?
  document  FamilyDocument?

  @@index([state, createdAt])
}

model Member {
  notificationsEnabled     Boolean                        @default(true)
  notificationPreferences  MemberNotificationPreference[]
  pointOfInterestPresences PointOfInterestPresence[]
  id                       Int                            @id @default(autoincrement())
  userId                   Int
  groupId                  Int
  role                     RoleEnum
  locationSharingEnabled   Boolean                        @default(false)

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  eventMembers          EventMember[]
  eventReminders        EventReminder[]
  recurrenceMembers     EventRecurrenceMember[]
  recurrenceReminders   EventRecurrenceReminder[]
  expenseAccountMembers ExpenseAccountMember[]

  @@unique([userId, groupId])
}

model GroupJoinRequest {
  id          Int                    @id @default(autoincrement())
  groupId     Int
  userId      Int
  status      GroupJoinRequestStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status, requestedAt])
  @@index([userId, status, requestedAt])
}

model GroupInboxNotification {
  id              Int       @id @default(autoincrement())
  recipientUserId Int
  groupId         Int
  type            String
  title           String
  body            String
  data            Json
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  recipient User  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([groupId, createdAt])
}

model Event {
  recurrenceId Int?
  occurrenceAt DateTime?
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  startAt      DateTime
  endAt        DateTime?
  groupId      Int
  locationId   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group           Group            @relation(fields: [groupId], references: [id])
  members         EventMember[]
  location        Location?        @relation(fields: [locationId], references: [id])
  reminders       EventReminder[]
  expenseAccounts ExpenseAccount[]

  recurrence EventRecurrence? @relation(fields: [recurrenceId], references: [id])

  @@unique([recurrenceId, occurrenceAt])
  @@index([groupId, startAt])
}

model EventMember {
  id       Int @id @default(autoincrement())
  eventId  Int
  memberId Int

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([memberId])
}

model EventReminder {
  id               Int       @id @default(autoincrement())
  eventId          Int
  memberId         Int
  leadMinutes      Int
  remindAt         DateTime
  sentAt           DateTime?
  utcOffsetMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId, leadMinutes])
  @@index([eventId])
  @@index([remindAt])
}

model ExpenseAccount {
  id      Int    @id @default(autoincrement())
  name    String
  groupId Int
  eventId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group                  @relation(fields: [groupId], references: [id])
  event   Event?                 @relation(fields: [eventId], references: [id])
  members ExpenseAccountMember[]

  @@index([groupId])
  @@index([eventId])
}

model ExpenseAccountMember {
  id               Int @id @default(autoincrement())
  expenseAccountId Int
  memberId         Int

  expenseAccount ExpenseAccount @relation(fields: [expenseAccountId], references: [id], onDelete: Cascade)
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseAccountId, memberId])
  @@index([memberId])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  description String
  dueDate     DateTime
  groupId     Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group Group @relation(fields: [groupId], references: [id])
}

enum PointOfInterestColor {
  RED
  GREEN
  ORANGE
  BLUE
  PURPLE
  GREY
  BLACK
}

enum PointOfInterestValidity {
  PERMANENT
  TWELVE_HOURS
  ONE_DAY
  THREE_DAYS
}

model PointOfInterest {
  color      PointOfInterestColor      @default(BLUE)
  presences  PointOfInterestPresence[]
  id         Int                       @id @default(autoincrement())
  name       String
  radius     Float
  validity   PointOfInterestValidity   @default(PERMANENT)
  endTime    DateTime?
  locationId Int                       @unique
  groupId    Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group    Group    @relation(fields: [groupId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
}

model Location {
  id              Int              @id @default(autoincrement())
  latitude        Float
  longitude       Float
  accuracy        Float?
  capturedAt      DateTime?
  lastSeenAt      DateTime?
  user            User?
  pointOfInterest PointOfInterest?
  events          Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberNotificationPreference {
  id        Int              @id @default(autoincrement())
  memberId  Int
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type])
}

model PointOfInterestPresence {
  id                Int             @id @default(autoincrement())
  memberId          Int
  pointOfInterestId Int
  isInside          Boolean
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  member            Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pointOfInterest   PointOfInterest @relation(fields: [pointOfInterestId], references: [id], onDelete: Cascade)

  @@unique([memberId, pointOfInterestId])
  @@index([pointOfInterestId])
}

model SecurityEvent {
  id             Int               @id @default(autoincrement())
  type           SecurityEventType
  ip             String?           @db.VarChar(45)
  userId         Int?
  identifierHash String?           @db.Char(64)
  method         String            @db.VarChar(10)
  path           String            @db.VarChar(500)
  statusCode     Int
  createdAt      DateTime          @default(now())

  @@index([type, createdAt])
  @@index([identifierHash, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model SecurityAlert {
  id             Int                 @id @default(autoincrement())
  type           SecurityAlertType
  correlationKey String              @db.VarChar(255)
  eventCount     Int
  windowSeconds  Int
  status         SecurityAlertStatus @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([type, correlationKey, createdAt])
}

enum EventRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model EventRecurrence {
  id          Int                       @id @default(autoincrement())
  frequency   EventRecurrenceFrequency
  until       DateTime?
  startAt     DateTime
  endAt       DateTime?
  name        String
  description String?
  groupId     Int
  group       Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members     EventRecurrenceMember[]
  reminders   EventRecurrenceReminder[]
  events      Event[]
  createdAt   DateTime                  @default(now())

  @@index([groupId])
}

model EventRecurrenceMember {
  recurrenceId Int
  memberId     Int
  recurrence   EventRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([recurrenceId, memberId])
  @@index([memberId])
}

model EventRecurrenceReminder {
  id               Int             @id @default(autoincrement())
  recurrenceId     Int
  memberId         Int
  leadMinutes      Int
  utcOffsetMinutes Int?
  recurrence       EventRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, memberId, leadMinutes])
  @@index([memberId])
}
