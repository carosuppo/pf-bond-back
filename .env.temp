PORT=3000
NODE_ENV=development

# Configuración para que NestJS conecte a la base de datos de Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=db_name

# String de conexión requerido por Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# Configuración para la autenticación por correo
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="tu_correo@gmail.com"
MAIL_PASSWORD="tu_app_password"
MAIL_FROM="Bond <tu_correo@gmail.com>"

API_BASE_URL="http://localhost:3000"