PORT=3000
NODE_ENV=development

# Configuración para que NestJS conecte a la base de datos de Docker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_NAME=bond
# Requerido por la imagen oficial de postgres para crear la base al iniciar
POSTGRES_DB=bond

# String de conexión requerido por Prisma
DATABASE_URL="postgresql://postgres:root@postgres:5432/bond?schema=public"

# Configuración para la autenticación por correo
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="tu_correo@gmail.com"
MAIL_PASSWORD="tu_app_password"
MAIL_FROM="Bond <tu_correo@gmail.com>"

API_BASE_URL="http://localhost:3000"